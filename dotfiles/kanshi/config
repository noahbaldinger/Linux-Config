# Laptop docked with both external monitors
profile docked-dual {
    output eDP-1 disable
    output DP-2 enable mode 2560x1440@240.001 position 0,0 scale 1
    output DP-4 enable mode 2560x1440@144.000 position 2560,0 scale 1
}


# Laptop only (no externals)
profile mobile {
    output eDP-1 enable mode 2880x1800@120.000 position 0,0 scale 1.75
}
